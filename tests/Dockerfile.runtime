# A clean ARM64 runtime, with only a CA bundle bootstrapped for HTTPS apt.
FROM --platform=linux/amd64 rust:1.90.0-slim-trixie@sha256:7fa728f3678acf5980d5db70960cf8491aff9411976789086676bdf0c19db39e AS certificates
FROM --platform=linux/arm64 debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY tests/runtime.sh /runtime.sh
ENTRYPOINT ["sh", "/runtime.sh"]
